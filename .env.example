# Server-only. Copy to .env.local for an explicitly chosen NON-production database.
# Never put production credentials in this example or NEXT_PUBLIC_* variables.
DATABASE_URL=postgresql://postgres:local-password@127.0.0.1:5432/limitpact_local
APP_ORIGIN=http://localhost:3000

# Leave empty for local manual testing: submissions persist; notifications remain pending.
RESEND_API_KEY=
FORM_NOTIFICATION_FROM=
FORM_NOTIFICATION_TO=ozavrahami7@gmail.com

# Operator-only full-access key for querying delivery / reconciling ambiguous attempts.
# The web service does not need this key. Never use it in client code.
RESEND_READ_API_KEY=
